<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>

    <!-- TESTS makes Diagnostics' sink a no-op, so the harness prints only what it means to. -->
    <DefineConstants>$(DefineConstants);TESTS</DefineConstants>
    <AssemblyName>CacheHitHarness</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>CacheHitHarness</RootNamespace>
  </PropertyGroup>

  <!-- The cache's own files, linked from the mod: the harness runs the real code. -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\Source\Interop\AddressCache.cs" Link="AddressCache.cs" />
    <Compile Include="..\..\Source\Interop\AddressCacheEntries.cs" Link="AddressCacheEntries.cs" />
    <Compile Include="..\..\Source\Interop\GameAssembly.cs" Link="GameAssembly.cs" />
    <Compile Include="..\..\Source\Diagnostics\Log.cs" Link="Log.cs" />
  </ItemGroup>
</Project>
